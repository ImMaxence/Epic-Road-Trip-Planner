# Copy to .env for a local run. On Coolify, set these in the resource's "Environment Variables":
# the SERVICE_* values are generated automatically, you only need PUBLIC_URL (and the optional ones).

# Public URL of the site (canonical URLs, sitemap, cookie security, CSRF origin check)
PUBLIC_URL=https://tripplanner.mbonnici.fr

# Database credentials and session secret (Coolify magic variables)
SERVICE_USER_MARIADB=roadtrip
SERVICE_PASSWORD_MARIADB=change-me-database-password
SERVICE_PASSWORD_MARIADBROOT=change-me-root-password
SERVICE_PASSWORD_64_JWT=change-me-to-a-long-random-string-of-at-least-32-characters
# Shared by the backend and the geo service for manual data refreshes from the administration
SERVICE_PASSWORD_GEOADMIN=change-me-geo-admin-token

# Visitors need no account: trips and favourites stay on their device.
# Administration (curating the shared-trips gallery): Google sign-in reserved to ADMIN_EMAILS.
# OAuth client of type "Web application" in Google Cloud Console,
# authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Administrators: comma-separated e-mails and/or whole domains, e.g. me@gmail.com, @mbonnici.fr
# Empty = no administration.
ADMIN_EMAILS=

# Address offered in the "Feedback / bug" dialog (mailto).
# Empty = GitHub issues only. Tip: use an alias, it is visible to visitors.
FEEDBACK_EMAIL=


# Optional — DataTourisme feed (dated events). Full download URL of your feed, key included.
DATATOURISME_FEED_URL=

# Set to true only if the domain is proxied by Cloudflare (orange cloud)
TRUST_CLOUDFLARE=false

# Optional — data sources
OSM_EXTRACT_URL=https://download.geofabrik.de/europe/france-latest.osm.pbf
OSM_REFRESH_DAYS=30
# Routing engines per travel mode (car / bike / on foot)
OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
