{
  "name": "epic-road-trip-backend",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Epic Road Trip Planner — public REST API (auth, trips, geo gateway)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
